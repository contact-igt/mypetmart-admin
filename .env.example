# Copy to .env (repo root, gitignored) and adjust as needed.
# Shared by compose.yaml (MySQL container) and apps/api (config/env.ts).
# Never commit the real .env — see .gitignore.

# --- apps/api ---
NODE_ENV=development
PORT=4000
DATABASE_URL="mysql://mypetmart:mypetmart_dev_password@localhost:3306/mypetmart"

# --- compose.yaml (MySQL 8.4 container) ---
# Must match the credentials embedded in DATABASE_URL above.
MYSQL_DATABASE=mypetmart
MYSQL_USER=mypetmart
MYSQL_PASSWORD=mypetmart_dev_password
MYSQL_ROOT_PASSWORD=mypetmart_root_dev_password
