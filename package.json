{
  "name": "mypetmart",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@11.18.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev:web": "pnpm --filter @mypetmart/web dev",
    "build:web": "pnpm --filter @mypetmart/web build",
    "lint:web": "pnpm --filter @mypetmart/web lint",
    "typecheck:web": "pnpm --filter @mypetmart/web typecheck",
    "dev:api": "pnpm --filter @mypetmart/api dev",
    "typecheck:api": "pnpm --filter @mypetmart/api typecheck",
    "lint:api": "pnpm --filter @mypetmart/api lint",
    "test:api": "pnpm --filter @mypetmart/api test",
    "prisma:validate": "pnpm --filter @mypetmart/api prisma:validate",
    "prisma:generate": "pnpm --filter @mypetmart/api prisma:generate"
  }
}
